# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: Wombcare_PreFinal2
label: Wombcare_PreFinal2
description: |
  A minimal project structure, that serves as a starting point for custom Bluetooth applications. The application starts advertising after boot and restarts advertising after a connection is closed.
category: Bluetooth Examples
filter:
- name: Device Type
  value:
  - SoC
- name: Project Difficulty
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Bluetooth
package: bluetooth_le_app
quality: production
readme:
- path: README.md
source:
- path: src/app.c
- path: src/app_bm.c
- path: src/main.c
- path: src/sl_gatt_service_device_information_override.c
- path: src/wombcare_sensors.c
- path: src/wombcare_buffer.c
- path: src/wombcare_dsp.c
- path: src/wombcare_imu.c
- path: src/wombcare_ble.c
- path: src/wombcare_ml.cc
# Generated by ml/ctg_train_export.py. Compiled in place so retraining cannot
# leave the firmware linked against a stale model.
# See ../../resources/docs/FEATURE_SPEC.md.
- path: ../wombcare-ml/artifacts/ctg/firmware/model_data.c
- path: ../wombcare-ml/artifacts/ctg/firmware/scaler.c
tag:
- hwfilter:device:device_supports_bluetooth
- hwfilter:device:device_series_2
include:
- path: inc
  file_list:
  - path: app.h
  - path: wombcare_sensors.h
  - path: wombcare_buffer.h
  - path: wombcare_dsp.h
  - path: wombcare_imu.h
  - path: wombcare_ble.h
  - path: wombcare_ml.h
- path: ../wombcare-ml/artifacts/ctg/firmware
  file_list:
  - path: model_data.h
  - path: scaler.h
  - path: golden_vectors.h
