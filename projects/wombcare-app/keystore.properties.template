# Copy to keystore.properties (gitignored) and fill in to sign a release build.
# Generate a keystore with:
#   keytool -genkey -v -keystore wombcare-release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias wombcare
storeFile=wombcare-release.jks
storePassword=CHANGE_ME
keyAlias=wombcare
keyPassword=CHANGE_ME
