# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: bt_soc_throughput_log_single_BGM220
label: bt_soc_throughput_log_single_BGM220
description: |
  This example tests the throughput capabilities of the device and can be used to measure throughput between 2 *EFR32* devices, as well as between a device and a smartphone using the 'Si Connect' mobile app, through the 'Throughput' demo tile.
category: Bluetooth Examples
filter:
- name: Device Type
  value:
  - SoC
- name: Project Difficulty
  value:
  - Advanced
- name: Wireless Technology
  value:
  - Bluetooth
package: bluetooth_le_app
quality: production
readme:
- path: readme.md
source:
- path: app.c
tag:
- hwfilter:board:simple_button:btn0
- hwfilter:board:simple_led:led0
- prebuilt_demo
- hwfilter:!board:hardware_board_supports_wstk_lcd
- hwfilter:device:device_supports_bluetooth
- hwfilter:ram:32k
- hwfilter:!board:simple_button:btn1
- hwfilter:device:device_series_2
include:
- path: .
  file_list:
  - path: app.h
sdk:
  vendor: silabs
  id: simplicity_sdk
  version: 2025.12.3
toolchain_settings: [
  ]
component:
- package: simplicity_sdk
  vendor: silabs
  id: BGM220PC22HNA
- package: simplicity_sdk
  vendor: silabs
  id: app_assert
- package: simplicity_sdk
  vendor: silabs
  id: app_log
- package: simplicity_sdk
  vendor: silabs
  id: app_os_helper
- package: simplicity_sdk
  vendor: silabs
  id: app_timer
- package: simplicity_sdk
  vendor: silabs
  id: bluetooth_stack
- package: simplicity_sdk
  vendor: silabs
  id: brd4314a
- package: simplicity_sdk
  instance:
  - example
  vendor: silabs
  id: cli
- package: simplicity_sdk
  vendor: silabs
  id: clock_manager
- package: simplicity_sdk
  vendor: silabs
  id: device_init
- package: simplicity_sdk
  vendor: silabs
  id: gatt_service_device_information_override
- package: simplicity_sdk
  vendor: silabs
  id: memory_manager
- package: simplicity_sdk
  vendor: silabs
  id: mpu
- package: simplicity_sdk
  instance:
  - btn0
  vendor: silabs
  id: simple_button
- package: simplicity_sdk
  instance:
  - led0
  vendor: silabs
  id: simple_led
- package: simplicity_sdk
